# Copy to settings.env and edit. Every script sources this file.
# ---------------------------------------------------------------------------

# --- Model ---------------------------------------------------------------
# Any GGUF works; these defaults are the exact pair this guide was measured on.
MODEL_REPO="unsloth/GLM-4.7-Flash-GGUF"
MODEL_FILE="GLM-4.7-Flash-UD-Q4_K_XL.gguf"
MODEL_ALIAS="glm-4.7-flash"

# --- Paths ---------------------------------------------------------------
# Everything lives under one root so uninstall is "rm -rf $LLM_ROOT".
LLM_ROOT="${HOME}/llm"

# --- Build ---------------------------------------------------------------
# Pinned llama.cpp tag. Newer tags usually work but flag names drift --
# see docs/03-build.md before bumping.
LLAMA_TAG="b10612"
# CUDA 12.x is MANDATORY on Pascal: CUDA 13 dropped sm_61 entirely.
CUDA_IMAGE="nvidia/cuda:12.6.3-devel-ubuntu22.04"
# Pascal = compute capability 6.1.
CUDA_ARCH="61"

# --- Serving -------------------------------------------------------------
# How many layers' MoE experts to keep in CPU RAM instead of VRAM.
# THIS IS THE KNOB THAT MAKES IT FIT. 26 was tuned for 11 GB (GTX 1080 Ti).
# Raise it if you OOM, lower it if you have VRAM to spare. See docs/05.
NCMOE="26"
CTX="32768"
PORT="8080"
# Bind to 127.0.0.1 for local-only. Use 0.0.0.0 to expose on your LAN --
# there is NO authentication on this endpoint. See the warning in docs/04.
HOST="127.0.0.1"
THREADS="8"
PARALLEL="1"
UBATCH="2048"
